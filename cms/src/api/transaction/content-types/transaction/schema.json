{
  "kind": "collectionType",
  "collectionName": "transactions",
  "info": {
    "singularName": "transaction",
    "pluralName": "transactions",
    "displayName": "💳 Transaction",
    "description": "BillDesk payment transactions with admin management fields"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "orderId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "bdOrderId": {
      "type": "string"
    },
    "transactionId": {
      "type": "string"
    },
    "amount": {
      "type": "decimal"
    },
    "status": {
      "type": "enumeration",
      "enum": ["INITIATED", "PENDING", "SUCCESS", "FAILED", "REVERSED", "REFUNDED"],
      "default": "PENDING"
    },
    "customerName": {
      "type": "string"
    },
    "customerMobile": {
      "type": "string"
    },
    "customerEmail": {
      "type": "string"
    },
    "feeType": {
      "type": "string"
    },
    "additionalInfo": {
      "type": "json"
    },
    "rawResponse": {
      "type": "json"
    },
    "previousStatus": {
      "type": "string"
    },
    "statusChangedBy": {
      "type": "string"
    },
    "statusChangedAt": {
      "type": "datetime"
    },
    "adminNotes": {
      "type": "text"
    },
    "refundId": {
      "type": "string"
    },
    "refundAmount": {
      "type": "decimal"
    },
    "refundedAt": {
      "type": "datetime"
    },
    "syncStatus": {
      "type": "enumeration",
      "enum": ["SYNCED", "PENDING", "FAILED"],
      "default": "SYNCED"
    },
    "retryCount": {
      "type": "integer",
      "default": 0
    },
    "lastSyncAttempt": {
      "type": "datetime"
    }
  }
}
